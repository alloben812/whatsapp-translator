{
  "name": "whatsapp-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal WhatsApp Russian–Serbian translation assistant",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js && python3 test/subscription-bridge.test.py && python3 test/owner-password.test.py",
    "demo": "npm run build && node dist/src/demo.js",
    "doctor": "node scripts/doctor.mjs",
    "start": "node dist/src/server.js >/dev/null 2>&1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode": "1.5.4"
  }
}
